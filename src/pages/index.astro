---
import Layout from "../layouts/Layout.astro";
import { APP_URL, absorbed, proofPoints } from "../config";

const description =
  "Programming software for coaches who write their own training. deload absorbs the planning, rewrites, and morning text answers so you can keep the relationship.";
---
<Layout title="deload" description={description}>
  <!-- Hero -->
  <section class="px-6 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="mx-auto max-w-container">
      <p class="mb-6 text-sm uppercase tracking-[0.18em] text-ink/50">
        Programming software for coaches
      </p>
      <h1 class="max-w-3xl text-balance text-4xl font-medium leading-[1.05] tracking-tight text-ink md:text-6xl">
        Give your <span
          id="hero-noun"
          data-nouns="athletes,clients,patients"
          class="text-sage"
        >athletes</span> the program they deserve &mdash; without losing your Sunday night.
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink/70 md:text-xl">
        deload writes block-aware training in your voice, edits with you in plain English, and adapts when life happens &mdash; so you can keep the relationship and skip the spreadsheet.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={APP_URL}
          class="inline-block rounded-full bg-ink px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/90"
        >Start free</a>
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/features`}
          class="inline-block rounded-full border border-ink/15 px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-ink/5"
        >See how it works</a>
      </div>
      <p class="mt-5 text-sm text-ink/50">
        Free during private beta &middot; no credit card
      </p>
    </div>
  </section>

  <!-- What this absorbs -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto max-w-container">
      <div class="mb-12 max-w-2xl">
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">
          What this absorbs for you
        </h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">
          The hours that don't show up on a roster.
        </p>
      </div>
      <ul class="grid gap-px overflow-hidden rounded-2xl bg-ink/10 md:grid-cols-2">
        {absorbed.map((item) => (
          <li class="bg-bg p-7 md:p-8">
            <p class="text-xs uppercase tracking-[0.16em] text-sage">
              {item.when}
            </p>
            <p class="mt-3 text-lg text-ink md:text-xl">{item.what}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Proof points -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto grid max-w-container gap-12 md:grid-cols-[1fr_1.2fr]">
      <div>
        <h2 class="text-sm uppercase tracking-[0.18em] text-clay">
          Built for real programming
        </h2>
        <p class="mt-3 text-3xl font-medium tracking-tight text-ink md:text-4xl">
          Not a workout app pretending to coach.
        </p>
      </div>
      <ul class="space-y-5 text-lg text-ink/80">
        {proofPoints.map((p) => (
          <li class="flex gap-3">
            <span aria-hidden="true" class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-sage" />
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Social proof placeholder -->
  <section class="border-t border-ink/10 px-6 py-20 md:py-28">
    <div class="mx-auto max-w-container">
      <h2 class="text-sm uppercase tracking-[0.18em] text-clay">From coaches in the beta</h2>
      <figure class="mt-6 max-w-3xl">
        <blockquote class="text-2xl font-medium leading-snug tracking-tight text-ink md:text-3xl">
          &ldquo;It writes the block I was going to write &mdash; and when Tuesday goes sideways, it rewrites the rest of the week before I get home.&rdquo;
        </blockquote>
        <figcaption class="mt-5 text-sm text-ink/60">
          {/* TODO: replace with a real coach quote + attribution before launch. */}
          Private beta coach &middot; strength and conditioning
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-ink/10 px-6 py-24 md:py-32">
    <div class="mx-auto max-w-container text-center">
      <h2 class="mx-auto max-w-2xl text-balance text-3xl font-medium tracking-tight text-ink md:text-5xl">
        Get your Sunday back.
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-ink/70">
        Free during private beta. No card, no setup call, no spreadsheet import.
      </p>
      <a
        href={APP_URL}
        class="mt-8 inline-block rounded-full bg-ink px-6 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/90"
      >Start free</a>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const el = document.getElementById("hero-noun");
    if (!el) return;
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) return;
    const nouns = (el.getAttribute("data-nouns") || "").split(",").map(function (n) { return n.trim(); }).filter(Boolean);
    if (nouns.length < 2) return;
    let i = 0;
    el.style.transition = "opacity 350ms ease";
    setInterval(function () {
      el.style.opacity = "0";
      setTimeout(function () {
        i = (i + 1) % nouns.length;
        el.textContent = nouns[i];
        el.style.opacity = "1";
      }, 350);
    }, 2200);
  })();
</script>
