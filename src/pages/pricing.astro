---
import Layout from "../layouts/Layout.astro";
import { APP_URL, faqs } from "../config";
---
<Layout
  title="Pricing"
  description="Free during private beta \u2014 no credit card required. Transparent pricing is coming once we leave beta."
>
  <section class="px-6 pt-20 pb-12 md:pt-28">
    <div class="mx-auto max-w-container">
      <p class="text-sm uppercase tracking-[0.18em] text-ink/50">Pricing</p>
      <h1 class="mt-4 max-w-2xl text-balance text-4xl font-medium leading-[1.1] tracking-tight md:text-5xl">
        Free during the private beta.
      </h1>
    </div>
  </section>

  <section class="px-6 pb-20">
    <div class="mx-auto max-w-container">
      <div class="rounded-2xl border border-ink/10 bg-ink/[0.02] p-8 md:p-12">
        <p class="text-xs uppercase tracking-[0.18em] text-clay">Private beta</p>
        <h2 class="mt-3 text-3xl font-medium tracking-tight md:text-4xl">
          Free &middot; no credit card required.
        </h2>
        <p class="mt-4 max-w-2xl text-lg text-ink/70">
          Transparent pricing is coming. While we're in private beta, you get the full product at no cost \u2014 we'd rather earn your trust before we ever ask for a card. When public pricing lands, you'll see it inside the app before anything changes.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={APP_URL}
            class="inline-block rounded-full bg-ink px-5 py-3 text-sm font-medium text-bg transition-colors hover:bg-ink/90"
          >Start free</a>
          <a
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact`}
            class="inline-block rounded-full border border-ink/15 px-5 py-3 text-sm font-medium text-ink transition-colors hover:bg-ink/5"
          >Talk to us</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-ink/10 px-6 py-20 md:py-24">
    <div class="mx-auto max-w-container">
      <h2 class="text-sm uppercase tracking-[0.18em] text-clay">FAQ</h2>
      <p class="mt-3 text-3xl font-medium tracking-tight md:text-4xl">
        Common questions.
      </p>
      <dl class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {faqs.map((f) => (
          <div class="grid gap-4 py-7 md:grid-cols-[1fr_1.6fr] md:gap-10">
            <dt class="text-lg font-medium text-ink">{f.q}</dt>
            <dd class="text-ink/75">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Layout>
