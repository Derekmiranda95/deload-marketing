---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<span class={`inline-flex items-baseline gap-1.5 font-medium tracking-tight ${className ?? ""}`}>
  <span
    aria-hidden="true"
    class="inline-flex h-5 w-5 items-center justify-center rounded-[6px] bg-ink text-bg text-[11px] font-semibold leading-none"
  >d</span>
  <span class="lowercase">deload</span>
</span>
